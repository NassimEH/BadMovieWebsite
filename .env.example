# Configuration BadMovie - PostgreSQL

# Clé secrète Flask (générez-en une avec: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=votre_secret_key_ici

# Clés TMDB API
API_key=votre_cle_tmdb_api
JetonTMDB=votre_token_tmdb

# Base de données PostgreSQL (automatiquement configurée par Docker Compose)
# DATABASE_URL=postgresql://badmovie:badmovie_password@db:5432/badmovie

# Pour développement local sans Docker (SQLite)
# SQLALCHEMY_DATABASE_URI=sqlite:///badmovie.db
